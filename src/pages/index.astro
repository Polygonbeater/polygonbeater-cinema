---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allEssays = await getCollection('essays');

const uniqueSlugs = Array.from(
  new Set(allEssays.map(e => e.id.replace(/^.*[\\/]/, '').replace(/\.md$/, '')))
);

const essays = uniqueSlugs.map(slug => {
  const czEntry = allEssays.find(e => e.id.replace(/\\/g, '/').includes(`cz/${slug}`));
  const enEntry = allEssays.find(e => e.id.replace(/\\/g, '/').includes(`en/${slug}`));
  
  return {
    slug: slug,
    poster: `/images/${slug}.webp`,
    date: czEntry?.data.date || enEntry?.data.date || '1970-01-01',
    title: { 
      cs: czEntry?.data.title || slug, 
      en: enEntry?.data.title || slug 
    },
    excerpt: { 
      cs: czEntry?.data.excerpt || czEntry?.data.description || "Český popisek není k dispozici.", 
      en: enEntry?.data.excerpt || enEntry?.data.description || "English excerpt not available." 
    },
    href: `/essays/${slug}`,
  };
});

essays.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const latestEssays = essays.slice(0, 12);
---

<Layout title="Polygon Beater Cinema — Filmové eseje">
  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <p class="eyebrow" lang="cs">Filmové eseje a analýzy</p>
        <p class="eyebrow" lang="en">Film Essays & Analyses</p>

        <h1 lang="cs">Kino jako temná místnost pro přemýšlení.</h1>
        <h1 lang="en">Cinema as a dark room for thinking.</h1>

        <p class="lead" lang="cs">
          Polygon Beater Cinema je prostor pro hloubkové filmové eseje a analýzy —
          texty, které se nespokojí s pouhým hodnocením, ale hledají obraz, rytmus
          a myšlenku ukrytou pod povrchem filmu. Autorský pohled, pevná
          estetika, žádné kompromisy.
        </p>
        <p class="lead" lang="en">
          Polygon Beater Cinema is a space for in-depth film essays and analyses —
          writing that isn't satisfied with a verdict, but searches for the
          image, rhythm, and idea hidden beneath a film's surface. A
          personal perspective, a distinct aesthetic, no compromises.
        </p>
      </div>
    </div>
  </section>

  <section class="essays">
    <div class="wrap">
      <h2 lang="cs">Nejnovější texty</h2>
      <h2 lang="en">Latest Texts</h2>

      <div class="essay-grid">
        {
          latestEssays.map((essay) => (
            <article class="essay-card">
              <a href={essay.href} class="essay-poster">
                <img
                  src={essay.poster}
                  alt={`${essay.title.cs} / ${essay.title.en}`}
                  loading="lazy"
                  width="600"
                  height="900"
                />
              </a>

              <div class="essay-content">
                <h3>
                  <span lang="cs">{essay.title.cs}</span>
                  <span lang="en">{essay.title.en}</span>
                </h3>

                <p class="essay-excerpt" lang="cs">{essay.excerpt.cs}</p>
                <p class="essay-excerpt" lang="en">{essay.excerpt.en}</p>

                <div class="essay-action">
                  <a href={essay.href} class="essay-link">
                    <span lang="cs">Číst celé →</span>
                    <span lang="en">Read full →</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 6rem 0 5rem; border-bottom: 1px solid var(--border); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.75rem; color: var(--accent); margin: 0 0 1rem; }
  .hero h1 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.2; margin: 0 0 1.5rem; max-width: 22ch; }
  .lead { color: var(--text-muted); font-size: 1.05rem; max-width: 65ch; margin: 0; }
  
  .essays { padding: 5rem 0 6rem; }
  .essays h2 { 
    font-family: var(--font-serif); 
    font-weight: 400; 
    font-size: 1.6rem; 
    margin: 0 0 2.5rem; 
    border-left: 3px solid var(--accent); 
    padding-left: 0.75rem; 
    background: none !important;
  }
  
  .essay-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); 
    gap: 1.5rem; 
    align-items: stretch;
  }
  
  .essay-card { 
    display: flex; 
    flex-direction: column; 
    background: var(--bg-elevated); 
    border: 1px solid var(--border); 
    border-radius: 4px; 
    padding: 1rem; 
    transition: border-color 0.2s ease;
  }
  .essay-card:hover {
    border-color: var(--accent);
  }
  
  .essay-poster { 
    display: block;
    width: 100%; 
    overflow: hidden; 
    border-radius: 2px; 
    border: 1px solid var(--border); 
    margin-bottom: 1rem; 
    text-decoration: none;
  }
  .essay-poster img { 
    width: 100%; 
    height: auto; 
    aspect-ratio: 2 / 3; 
    object-fit: cover; 
    filter: grayscale(0.15) contrast(1.05); 
    transition: filter 0.25s ease, transform 0.25s ease; 
  }
  .essay-card:hover .essay-poster img { 
    filter: grayscale(0) contrast(1.1); 
    transform: scale(1.02); 
  }
  
  .essay-content { 
    display: flex; 
    flex-direction: column; 
    flex-grow: 1;
  }
  .essay-content h3 { 
    font-family: var(--font-serif); 
    font-weight: 405; 
    font-size: 1.05rem; 
    line-height: 1.3;
    margin: 0 0 0.5rem; 
  }
  .essay-excerpt { 
    color: var(--text-muted); 
    font-size: 0.82rem; 
    line-height: 1.4;
    margin: 0 0 1rem; 
    flex-grow: 1;
  }
  .essay-action { 
    margin-top: auto;
  }
  .essay-link { 
    text-decoration: none; 
    font-size: 0.8rem; 
    letter-spacing: 0.03em; 
    color: var(--accent); 
    border-bottom: 1px solid transparent; 
    transition: border-color 0.15s ease; 
  }
  .essay-link:hover { border-color: var(--accent); }
</style>
