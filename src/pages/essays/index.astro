---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

function getCleanSlug(entry: { id: string }) {
  return entry.id
    .replace(/^.*[\\/]/, '')
    .replace(/\.(mdx?)$/, '')
    .replace(/^(cz|en)[_-]/i, '');
}

const allEssays = await getCollection('essays');
const uniqueSlugs = Array.from(new Set(allEssays.map(getCleanSlug)));

const essays = uniqueSlugs.map(slug => {
  const czEntry = allEssays.find(e => {
    const isCz = e.id.includes('cz/') || e.id.startsWith('cz-') || e.data?.lang === 'cs' || e.data?.lang === 'cz';
    return isCz && getCleanSlug(e) === slug;
  }) || allEssays.find(e => getCleanSlug(e) === slug);

  const enEntry = allEssays.find(e => {
    const isEn = e.id.includes('en/') || e.id.startsWith('en-') || e.data?.lang === 'en';
    return isEn && getCleanSlug(e) === slug;
  });

  const titleCs = czEntry?.data.title || enEntry?.data.title || slug;
  const titleEn = enEntry?.data.title || czEntry?.data.title || slug;
  const director = czEntry?.data.director || enEntry?.data.director || czEntry?.data.director_name || '';
  const poster = czEntry?.data.image || enEntry?.data.image || `/images/${slug}.webp`;
  const excerptCs = czEntry?.data.excerpt || czEntry?.data.description || '';
  const excerptEn = enEntry?.data.excerpt || enEntry?.data.description || '';
  
  // Body esejí záměrně vynecháno – celé texty v DOM atributech by při 430+ eseji
  // způsobily přetížení parseru. Pro full-text hledání načtěte search-index.json asynchronně.
  const searchableContent = `${titleCs} ${titleEn} ${director} ${excerptCs} ${excerptEn}`.toLowerCase();

  return {
    slug,
    poster,
    date: czEntry?.data.date || enEntry?.data.date || '',
    year: czEntry?.data.year || enEntry?.data.year || null,
    director,
    title: { cs: titleCs, en: titleEn },
    excerpt: { cs: excerptCs || "Český popisek není k dispozici.", en: excerptEn || "English excerpt not available." },
    searchableContent,
    href: `/essays/${slug}`,
  };
});

const toTime = (d: string | Date | undefined) => (d ? new Date(d).getTime() : 0);
essays.sort((a, b) => toTime(b.date) - toTime(a.date));

const directors = Array.from(new Set(essays.map(e => e.director).filter(Boolean))).sort();
const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<Layout title="Archiv esejí — Polygon Beater Cinema">
  <section class="archive-header">
    <div class="wrap">
      <a href="/" class="back-link">
        ← <span lang="cs">Zpět na úvod</span><span lang="en">Back to home</span>
      </a>
      <h1>
        <span lang="cs">Archiv všech esejí</span>
        <span lang="en">All Essays Archive</span>
      </h1>
      <p class="lead" lang="cs">Kompletní přehled publikovaných filmových esejí a analýz s možností vyhledávání a filtrování.</p>
      <p class="lead" lang="en">Complete collection of published film essays and analyses with search and filtering.</p>
    </div>
  </section>

  <section class="archive-controls wrap">
    <!-- Vyhledávací lišta a filtr podle režiséra -->
    <div class="search-bar-row">
      <div class="search-input-group">
        <input 
          type="search" 
          id="searchInput" 
          placeholder="Hledat v názvu, režisérovi, textu..." 
          aria-label="Vyhledat v esejích"
        />
        <span class="search-icon" aria-hidden="true">🔍</span>
      </div>

      {directors.length > 0 && (
        <div class="director-select-group">
          <select id="directorSelect" aria-label="Filtr podle režiséra">
            <option value="" id="directorDefaultOpt">Všichni režiséři</option>
            {directors.map(dir => (
              <option value={dir}>{dir}</option>
            ))}
          </select>
        </div>
      )}

      <button id="resetFiltersBtn" class="reset-btn" type="button">
        <span lang="cs">Resetovat filtry</span>
        <span lang="en">Reset filters</span>
      </button>
    </div>

    <!-- Abecední lišta (A–Z) -->
    <div class="alphabet-bar" id="alphabetBar">
      <button class="alpha-btn active" data-letter="" aria-pressed="true">
        <span lang="cs">VŠE</span>
        <span lang="en">ALL</span>
      </button>
      {alphabet.map(letter => (
        <button class="alpha-btn" data-letter={letter} aria-pressed="false">{letter}</button>
      ))}
      <button class="alpha-btn" data-letter="NUM" aria-pressed="false">#</button>
    </div>

    <!-- Počítadlo výsledků + loading indikátor -->
    <div class="results-meta">
      <span id="resultsCount"></span>
      <span id="searchLoading" class="search-loading" hidden>
        <span lang="cs">Načítám full-text…</span>
        <span lang="en">Loading full-text…</span>
      </span>
    </div>
  </section>

  <section class="essays">
    <div class="wrap">
      <div class="essay-grid" id="essayGrid">
        {
          essays.map((essay) => (
            <article 
              class="essay-card hidden"
              data-slug={essay.slug}
              data-title-cs={essay.title.cs.toLowerCase()}
              data-title-en={essay.title.en.toLowerCase()}
              data-director={essay.director.toLowerCase()}
              data-searchable={essay.searchableContent}
              data-first-letter={essay.title.cs.charAt(0).toUpperCase()}
              data-first-letter-en={essay.title.en.charAt(0).toUpperCase()}
            >
              <a 
                href={essay.href} 
                class="essay-poster"
                aria-label={`Esej: ${essay.title.cs} / ${essay.title.en}`}
              >
                <img
                  src={essay.poster}
                  alt={`${essay.title.cs} / ${essay.title.en}`}
                  loading="lazy"
                  width="600"
                  height="900"
                />
              </a>

              <div class="essay-content">
                <h3>
                  <span lang="cs">{essay.title.cs}</span>
                  <span lang="en">{essay.title.en}</span>
                </h3>

                {essay.director && (
                  <p class="essay-director">
                    <span aria-hidden="true">🎬 </span>
                    <span>{essay.director}</span>
                    {essay.year && <span class="essay-year">({essay.year})</span>}
                  </p>
                )}

                <p class="essay-excerpt" lang="cs">{essay.excerpt.cs}</p>
                <p class="essay-excerpt" lang="en">{essay.excerpt.en}</p>

                <div class="essay-action">
                  <a href={essay.href} class="essay-link">
                    <span lang="cs">Číst celé →</span>
                    <span lang="en">Read full →</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div id="noResults" class="no-results hidden">
        <p lang="cs">Zadaným kritériím neodpovídá žádná esej.</p>
        <p lang="en">No essays match your search criteria.</p>
      </div>

      <!-- Ovládání stránkování -->
      <nav class="pagination" id="paginationControls" aria-label="Stránkování / Pagination">
        <button id="prevPageBtn" class="page-nav-btn" type="button" disabled>
          ← <span lang="cs">Předchozí</span><span lang="en">Previous</span>
        </button>
        <div id="pageNumbers" class="page-numbers"></div>
        <button id="nextPageBtn" class="page-nav-btn" type="button" disabled>
          <span lang="cs">Další</span><span lang="en">Next</span> →
        </button>
      </nav>
    </div>
  </section>
</Layout>

<script>
  // Fuse.js načteme z CDN jen pokud ho potřebujeme
  // (neinstalujeme jako npm balíček – šetříme bundle size)
  const FUSE_CDN = 'https://cdn.jsdelivr.net/npm/fuse.js@7/dist/fuse.min.js';

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const directorSelect = document.getElementById('directorSelect') as HTMLSelectElement | null;
    const directorDefaultOpt = document.getElementById('directorDefaultOpt');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const alphabetBar = document.getElementById('alphabetBar');
    const alphaButtons = alphabetBar?.querySelectorAll('.alpha-btn') || [];
    const essayCards = Array.from(document.querySelectorAll('.essay-card')) as HTMLElement[];
    const resultsCount = document.getElementById('resultsCount');
    const noResults = document.getElementById('noResults');
    const paginationControls = document.getElementById('paginationControls');
    const prevPageBtn = document.getElementById('prevPageBtn') as HTMLButtonElement | null;
    const nextPageBtn = document.getElementById('nextPageBtn') as HTMLButtonElement | null;
    const pageNumbers = document.getElementById('pageNumbers');
    const searchLoading = document.getElementById('searchLoading');

    const ITEMS_PER_PAGE = 16;
    let currentPage = 1;
    let selectedLetter = '';
    let matchingCards: HTMLElement[] = [];

    // --- Full-text search stav ---
    type FuseInstance = any;
    let fuse: FuseInstance | null = null;
    let fuseLoading = false;
    let fuseReady = false;
    // Sady slugů nalezených full-textem (null = index ještě nenačten)
    let fullTextSlugs: Set<string> | null = null;

    function getLang(): 'cs' | 'en' {
      const htmlLang = document.documentElement.getAttribute('lang')
        || document.documentElement.getAttribute('data-lang') || 'cs';
      return htmlLang.toLowerCase().includes('en') ? 'en' : 'cs';
    }

    function setLoadingIndicator(visible: boolean) {
      if (!searchLoading) return;
      searchLoading.hidden = !visible;
    }

    // Načte Fuse.js z CDN a pak search-index.json – pouze jednou
    async function loadFuse() {
      if (fuseReady || fuseLoading) return;
      fuseLoading = true;
      setLoadingIndicator(true);

      try {
        // 1. Načti Fuse.js z CDN pokud ještě není
        if (!(window as any).Fuse) {
          await new Promise<void>((resolve, reject) => {
            const script = document.createElement('script');
            script.src = FUSE_CDN;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('Fuse.js load failed'));
            document.head.appendChild(script);
          });
        }

        // 2. Načti search index
        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        // 3. Vytvoř Fuse instanci – klíče odpovídají search-index.json.ts
        fuse = new (window as any).Fuse(data, {
          keys: [
            { name: 'title_cs',  weight: 0.25 },
            { name: 'title_en',  weight: 0.25 },
            { name: 'director',  weight: 0.15 },
            { name: 'body_cs',   weight: 0.175 },
            { name: 'body_en',   weight: 0.175 },
          ],
          threshold: 0.35,
          minMatchCharLength: 3,
          includeScore: true,
          ignoreLocation: true,
        });

        fuseReady = true;
      } catch (err) {
        console.warn('[Search] Nepodařilo se načíst full-text index:', err);
        // Fallback – DOM search bude fungovat dál
        fuseReady = false;
      } finally {
        fuseLoading = false;
        setLoadingIndicator(false);
        // Spusť filtrování znovu s načteným indexem
        filterEssays();
      }
    }

    // Spustí full-text vyhledávání přes Fuse a vrátí Set slugů
    function runFullTextSearch(query: string): Set<string> | null {
      if (!fuseReady || !fuse || query.length < 3) return null;
      const results = fuse.search(query);
      return new Set(results.map((r: any) => r.item.slug as string));
    }

    function updateLocalizedTexts() {
      const lang = getLang();
      if (searchInput) {
        searchInput.placeholder = lang === 'en'
          ? 'Search in title, director, text...'
          : 'Hledat v názvu, režisérovi, textu...';
      }
      if (directorDefaultOpt) {
        directorDefaultOpt.textContent = lang === 'en' ? 'All directors' : 'Všichni režiséři';
      }
    }

    let lastRenderedTotalPages = -1;

    function renderPagination(totalPages: number) {
      if (!pageNumbers || !paginationControls) return;

      if (totalPages <= 1) {
        paginationControls.style.display = 'none';
        lastRenderedTotalPages = totalPages;
        return;
      }

      paginationControls.style.display = 'flex';

      if (totalPages !== lastRenderedTotalPages) {
        pageNumbers.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.className = 'page-num-btn';
          btn.textContent = i.toString();
          btn.type = 'button';
          btn.dataset.page = String(i);
          btn.addEventListener('click', () => {
            currentPage = i;
            updateGridDisplay();
            scrollToGridTop();
            syncUrl();
          });
          pageNumbers.appendChild(btn);
        }
        lastRenderedTotalPages = totalPages;
      }

      pageNumbers.querySelectorAll<HTMLButtonElement>('.page-num-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.page === String(currentPage));
      });

      if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
      if (nextPageBtn) nextPageBtn.disabled = currentPage === totalPages;
    }

    function scrollToGridTop() {
      document.querySelector('.archive-controls')
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function updateGridDisplay() {
      const lang = getLang();
      const totalMatching = matchingCards.length;
      const totalPages = Math.ceil(totalMatching / ITEMS_PER_PAGE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      essayCards.forEach(card => card.classList.add('hidden'));

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const pageCards = matchingCards.slice(startIndex, startIndex + ITEMS_PER_PAGE);
      pageCards.forEach(card => card.classList.remove('hidden'));

      if (resultsCount) {
        if (totalMatching === 0) {
          resultsCount.textContent = lang === 'en' ? '0 essays found' : 'Nalezeno 0 esejí';
        } else {
          const source = fuseReady ? (lang === 'en' ? ' (full-text)' : ' (full-text)') : '';
          resultsCount.textContent = lang === 'en'
            ? `Showing ${pageCards.length} of ${totalMatching} essays${source} (Page ${currentPage} of ${totalPages})`
            : `Zobrazeno ${pageCards.length} z ${totalMatching} esejí${source} (Strana ${currentPage} z ${totalPages})`;
        }
      }

      if (noResults) {
        noResults.classList.toggle('hidden', totalMatching > 0);
      }

      renderPagination(totalPages);
    }

    function filterEssays() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedDirector = (directorSelect?.value || '').toLowerCase().trim();
      const currentLang = getLang();

      // Full-text výsledky – null pokud index ještě není načten nebo dotaz příliš krátký
      fullTextSlugs = runFullTextSearch(query);

      matchingCards = essayCards.filter(card => {
        const searchable = card.dataset.searchable || '';
        const director   = card.dataset.director   || '';
        const slug       = card.dataset.slug        || '';
        const firstLetter = (currentLang === 'en'
          ? card.dataset.firstLetterEn
          : card.dataset.firstLetter) || '';

        let matchesQuery = true;
        if (query) {
          if (fullTextSlugs !== null) {
            // Index načten – kombinuj DOM search i full-text
            matchesQuery = searchable.includes(query) || fullTextSlugs.has(slug);
          } else {
            // Index ještě nenačten – použij jen DOM search
            matchesQuery = searchable.includes(query);
          }
        }

        const matchesDirector = !selectedDirector || director === selectedDirector;

        let matchesLetter = true;
        if (selectedLetter) {
          matchesLetter = selectedLetter === 'NUM'
            ? /^[0-9]/.test(firstLetter)
            : firstLetter === selectedLetter;
        }

        return matchesQuery && matchesDirector && matchesLetter;
      });

      currentPage = 1;
      updateGridDisplay();
    }

    function syncUrl() {
      const params = new URLSearchParams();
      const q   = searchInput?.value.trim() || '';
      const dir = directorSelect?.value || '';
      if (q)             params.set('q', q);
      if (dir)           params.set('director', dir);
      if (selectedLetter) params.set('letter', selectedLetter);
      if (currentPage > 1) params.set('page', String(currentPage));
      const newUrl = params.toString()
        ? `${location.pathname}?${params}`
        : location.pathname;
      history.replaceState(null, '', newUrl);
    }

    function restoreFromUrl() {
      const params = new URLSearchParams(location.search);
      const q      = params.get('q')        || '';
      const dir    = params.get('director') || '';
      const letter = params.get('letter')   || '';
      const page   = parseInt(params.get('page') || '1', 10);

      if (searchInput && q)   searchInput.value   = q;
      if (directorSelect && dir) directorSelect.value = dir;
      if (letter) {
        selectedLetter = letter;
        alphaButtons.forEach(b => {
          const isActive = (b as HTMLElement).dataset.letter === letter;
          b.classList.toggle('active', isActive);
          (b as HTMLElement).setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }
      currentPage = isNaN(page) || page < 1 ? 1 : page;
    }

    // Načti Fuse.js + index při prvním focusu na search (lazy)
    searchInput?.addEventListener('focus', loadFuse, { once: true });

    // Debounce search
    let searchTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimer);
      // Pokud index ještě není načten a query >= 3 znaky, spusť načítání
      if (!fuseReady && !fuseLoading && (searchInput?.value.trim().length ?? 0) >= 3) {
        loadFuse();
      }
      searchTimer = setTimeout(() => {
        filterEssays();
        syncUrl();
      }, 200);
    });

    directorSelect?.addEventListener('change', () => {
      filterEssays();
      syncUrl();
    });

    alphaButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        alphaButtons.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        (btn as HTMLElement).setAttribute('aria-pressed', 'true');
        selectedLetter = (btn as HTMLElement).dataset.letter || '';
        filterEssays();
        syncUrl();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput)   searchInput.value   = '';
      if (directorSelect) directorSelect.value = '';
      selectedLetter = '';
      alphaButtons.forEach(b => {
        b.classList.remove('active');
        (b as HTMLElement).setAttribute('aria-pressed', 'false');
      });
      const allBtn = alphabetBar?.querySelector('[data-letter=""]');
      allBtn?.classList.add('active');
      (allBtn as HTMLElement | null)?.setAttribute('aria-pressed', 'true');
      filterEssays();
      syncUrl();
    });

    prevPageBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updateGridDisplay();
        scrollToGridTop();
        syncUrl();
      }
    });

    nextPageBtn?.addEventListener('click', () => {
      const totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE);
      if (currentPage < totalPages) {
        currentPage++;
        updateGridDisplay();
        scrollToGridTop();
        syncUrl();
      }
    });

    const observer = new MutationObserver(() => {
      updateLocalizedTexts();
      updateGridDisplay();
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['lang', 'data-lang', 'class'],
    });

    // Inicializace
    restoreFromUrl();
    updateLocalizedTexts();
    filterEssays();
  });
</script>

<style>
  .archive-header { padding: 4rem 0 2rem; border-bottom: 1px solid var(--border); }
  .back-link { display: inline-block; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; margin-bottom: 1.5rem; transition: color 0.15s ease; }
  .back-link:hover { color: var(--accent); }
  .archive-header h1 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 1rem; }
  .lead { color: var(--text-muted); font-size: 1.05rem; margin: 0; }

  .archive-controls { margin-top: 2.5rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .search-bar-row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .search-input-group { position: relative; flex: 1 1 300px; }
  .search-input-group input { width: 100%; padding: 0.75rem 2.5rem 0.75rem 1rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; color: var(--text); font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s ease; }
  .search-input-group input:focus { outline: none; border-color: var(--accent); }
  .search-icon { position: absolute; right: 0.8rem; top: 50%; transform: translateY(-50%); opacity: 0.5; pointer-events: none; }

  .director-select-group select { padding: 0.75rem 1rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; color: var(--text); font-size: 0.95rem; font-family: inherit; cursor: pointer; transition: border-color 0.2s ease; }
  .director-select-group select:focus { outline: none; border-color: var(--accent); }

  .reset-btn { padding: 0.75rem 1.2rem; background: transparent; border: 1px solid var(--border); color: var(--text-muted); border-radius: 4px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s ease; font-family: inherit; }
  .reset-btn:hover { border-color: var(--accent); color: var(--accent); }

  .alphabet-bar { display: flex; flex-wrap: wrap; gap: 0.35rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }
  .alpha-btn { background: var(--bg-elevated); border: 1px solid var(--border); color: var(--text-muted); padding: 0.35rem 0.65rem; font-size: 0.8rem; border-radius: 3px; cursor: pointer; transition: all 0.15s ease; font-family: inherit; }
  .alpha-btn:hover, .alpha-btn.active { background: var(--accent); color: var(--bg); border-color: var(--accent); font-weight: bold; }

  .results-meta { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: -0.5rem; display: flex; align-items: center; gap: 1rem; }
  .search-loading { font-size: 0.8rem; color: var(--accent); opacity: 0.8; animation: pulse 1.2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }

  .essays { padding: 2rem 0 6rem; }
  .essay-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1.5rem; align-items: stretch; }
  .essay-card { display: flex; flex-direction: column; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; padding: 1rem; transition: border-color 0.2s ease, opacity 0.2s ease; }
  .essay-card.hidden { display: none !important; }
  .essay-card:hover { border-color: var(--accent); }
  .essay-poster { display: block; width: 100%; overflow: hidden; border-radius: 2px; border: 1px solid var(--border); margin-bottom: 1rem; text-decoration: none; }
  .essay-poster img { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; filter: grayscale(0.15) contrast(1.05); transition: filter 0.25s ease, transform 0.25s ease; }
  .essay-card:hover .essay-poster img { filter: grayscale(0) contrast(1.1); transform: scale(1.02); }
  .essay-content { display: flex; flex-direction: column; flex-grow: 1; }
  .essay-content h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.05rem; line-height: 1.3; margin: 0 0 0.3rem; }
  .essay-director { font-size: 0.78rem; color: var(--accent); margin: 0 0 0.6rem; opacity: 0.9; }
