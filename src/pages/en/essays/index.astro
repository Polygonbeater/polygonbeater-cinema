---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

function getCleanSlug(entry: { id: string }) {
  return entry.id
    .replace(/^.*[\\/]/, '')
    .replace(/\.(mdx?)$/, '')
    .replace(/^(cz|cs|en)[_-]/i, '');
}

function getFirstLetter(str: string): string {
  if (!str) return '';
  return str.trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').charAt(0).toUpperCase();
}

// Překladová tabulka žánrů CZ -> EN. Používá se na anglické verzi archivu,
// protože ne každá esej má vlastní vyplněné anglické `genres` pole — u těch
// se v kódu níž spadne zpátky na české `czEntry.data.genres`. Bez téhle
// tabulky by se pak v anglickém filtru objevovala česká slova. Zároveň
// sloučí duplicitní páry (Horor + Horror) do jednoho tagu.
const genreTranslations: Record<string, string> = {
  'Akční': 'Action',
  'Animovaný': 'Animation',
  'Animovaný dokument': 'Animated Documentary',
  'Avantgarda': 'Avant-garde',
  'Biografický': 'Biographical',
  'Body horor': 'Body Horror',
  'Cestopisný': 'Travelogue',
  'Černá komedie': 'Black Comedy',
  'Dobový': 'Period',
  'Dobrodružný': 'Adventure',
  'Dokumentární': 'Documentary',
  'Duchovní drama': 'Spiritual Drama',
  'Dystopie': 'Dystopia',
  'Environmentální': 'Environmental',
  'Erotický thriller': 'Erotic Thriller',
  'Esej': 'Essay',
  'Experimentální': 'Experimental',
  'Expresionismus': 'Expressionism',
  'Exotický': 'Exotic',
  'Filozofický': 'Philosophical',
  'Folklor': 'Folklore',
  'Folk horor': 'Folk Horror',
  'Gotické melodrama': 'Gothic Melodrama',
  'Gotický': 'Gothic',
  'Gotický horor': 'Gothic Horror',
  'Historický': 'Historical',
  'Horor': 'Horror',
  'Hudební': 'Musical',
  'Institucionální drama': 'Institutional Drama',
  'Investigativní': 'Investigative',
  'Japonský film': 'Japanese Film',
  'Japonský horor': 'Japanese Horror',
  'Klasický český film': 'Classic Czech Cinema',
  'Klasický Hollywood': 'Classic Hollywood',
  'Klasický horor': 'Classic Horror',
  'Komedie': 'Comedy',
  'Komedie mravů': 'Comedy of Manners',
  'Krátkometrážní': 'Short Film',
  'Krimi': 'Crime',
  'Kultovní': 'Cult',
  'Mediální drama': 'Media Drama',
  'Metakino': 'Meta-cinema',
  'Milenci na útěku': 'Lovers on the Run',
  'Mysteriózní': 'Mystery',
  'Mystický': 'Mystical',
  'Mytologický': 'Mythological',
  'Němý film': 'Silent Film',
  'Neorealismus': 'Italian Neorealism',
  'Nová vlna': 'French New Wave',
  'Pohádka': 'Fairy Tale',
  'Politická alegorie': 'Political Allegory',
  'Politická satira': 'Political Satire',
  'Politické drama': 'Political Drama',
  'Politický': 'Political',
  'Politický thriller': 'Political Thriller',
  'Postapokalyptický': 'Post-apocalyptic',
  'Procedurální': 'Procedural',
  'Protiválečný': 'Anti-war',
  'Přírodní': 'Nature',
  'Přírodní thriller': 'Nature Thriller',
  'Psychologické drama': 'Psychological Drama',
  'Psychologický': 'Psychological',
  'Psychologický horor': 'Psychological Horror',
  'Psychologický thriller': 'Psychological Thriller',
  'Romantický': 'Romance',
  'Satira': 'Satire',
  'Sociální': 'Social Drama',
  'Sociální satira': 'Social Satire',
  'Sociologický thriller': 'Sociological Thriller',
  'Soudní drama': 'Courtroom Drama',
  'Sportovní': 'Sports',
  'Špionážní': 'Espionage',
  'Technologický': 'Technological',
  'Tragédie': 'Tragedy',
  'Transgresivní': 'Transgressive',
  'Utopie': 'Utopia',
  'Válečný': 'War',
};

function translateGenre(genre: string): string {
  return genreTranslations[genre] || genre;
}

const allEssays = await getCollection('essays');
const uniqueSlugs = Array.from(new Set(allEssays.map(getCleanSlug)));

const essays = uniqueSlugs.map(slug => {
  const czEntry = allEssays.find(e => {
    const isCz = /(^|\/)(cs|cz)[/_-]/i.test(e.id) || e.data?.lang === 'cs' || e.data?.lang === 'cz';
    return isCz && getCleanSlug(e) === slug;
  }) || allEssays.find(e => getCleanSlug(e) === slug);

  const enEntry = allEssays.find(e => {
    const isEn = /(^|\/)en[/_-]/i.test(e.id) || e.data?.lang === 'en';
    return isEn && getCleanSlug(e) === slug;
  });

  const titleCs = czEntry?.data.title || enEntry?.data.title || slug;
  const titleEn = enEntry?.data.title || czEntry?.data.title || slug;
  const director = enEntry?.data.director || czEntry?.data.director || enEntry?.data.director_name || czEntry?.data.director_name || '';
  const poster = enEntry?.data.image || czEntry?.data.image || `/images/${slug}.webp`;
  const excerptCs = czEntry?.data.excerpt || czEntry?.data.description || '';
  const excerptEn = enEntry?.data.excerpt || enEntry?.data.description || '';

  const rawGenres: string[] = (enEntry?.data.genres && enEntry.data.genres.length > 0) ? enEntry.data.genres : (czEntry?.data.genres || []);
  const genres = Array.from(new Set(rawGenres.map(translateGenre)));

  const searchableContent = `${titleEn} ${titleCs} ${director} ${genres.join(' ')} ${excerptEn} ${excerptCs}`.toLowerCase();

  return {
    slug,
    poster,
    date: enEntry?.data.date || czEntry?.data.date || '',
    year: enEntry?.data.year || czEntry?.data.year || null,
    director,
    genres,
    title: { cs: titleCs, en: titleEn },
    excerpt: { cs: excerptCs || "Český popisek není k dispozici.", en: excerptEn || "English excerpt not available." },
    searchableContent,
    href: `/en/essays/${slug}`,
  };
});

const toTime = (d: string | Date | undefined) => (d ? new Date(d).getTime() : 0);
essays.sort((a, b) => toTime(b.date) - toTime(a.date));

const directors = Array.from(new Set(essays.map(e => e.director).filter(Boolean))).sort();
const allGenres = Array.from(new Set(essays.flatMap(e => e.genres || []))).sort();
const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<Layout title="All Essays Archive — Polygon Beater Cinema">
  <section class="archive-header">
    <div class="wrap">
      <a href="/en" class="back-link">
        ← <span>Back to home</span>
      </a>
      <h1>
        <span>All Essays Archive</span>
      </h1>
      <p class="lead">Complete collection of published film essays and analyses with search and filtering by genres and directors.</p>
    </div>
  </section>

  <section class="archive-controls wrap">
    <!-- Search bar and Filters row -->
    <div class="search-bar-row">
      <div class="search-input-group">
        <input 
          type="search" 
          id="searchInput" 
          placeholder="Search in title, director, genre, text..." 
          aria-label="Search essays"
        />
        <span class="search-icon" aria-hidden="true">🔍</span>
      </div>

      {allGenres.length > 0 && (
        <div class="filter-select-group">
          <select id="genreSelect" aria-label="Filter by genre">
            <option value="" id="genreDefaultOpt">All genres</option>
            {allGenres.map(genre => (
              <option value={genre}>{genre}</option>
            ))}
          </select>
        </div>
      )}

      {directors.length > 0 && (
        <div class="filter-select-group">
          <select id="directorSelect" aria-label="Filter by director">
            <option value="" id="directorDefaultOpt">All directors</option>
            {directors.map(dir => (
              <option value={dir}>{dir}</option>
            ))}
          </select>
        </div>
      )}

      <button id="resetFiltersBtn" class="reset-btn" type="button">
        Reset filters
      </button>
    </div>

    <!-- Alphabet Bar (A–Z) -->
    <div class="alphabet-bar" id="alphabetBar">
      <button class="alpha-btn active" data-letter="" aria-pressed="true">
        ALL
      </button>
      {alphabet.map(letter => (
        <button class="alpha-btn" data-letter={letter} aria-pressed="false">{letter}</button>
      ))}
      <button class="alpha-btn" data-letter="NUM" aria-pressed="false">#</button>
    </div>

    <!-- Results meta + loading indicator -->
    <div class="results-meta">
      <span id="resultsCount"></span>
      <span id="searchLoading" class="search-loading" hidden>
        Loading full-text…
      </span>
    </div>
  </section>

  <section class="essays">
    <div class="wrap">
      <div class="essay-grid" id="essayGrid">
        {
          essays.map((essay) => (
            <article 
              class="essay-card hidden"
              data-slug={essay.slug}
              data-title-en={essay.title.en.toLowerCase()}
              data-director={essay.director.toLowerCase()}
              data-genres={essay.genres.join(',').toLowerCase()}
              data-searchable={essay.searchableContent}
              data-first-letter={getFirstLetter(essay.title.en)}
            >
              <a 
                href={essay.href} 
                class="essay-poster"
                aria-label={`Essay: ${essay.title.en}`}
              >
                <img
                  src={essay.poster}
                  alt={`${essay.title.en}`}
                  loading="lazy"
                  width="600"
                  height="900"
                />
              </a>

              <div class="essay-content">
                <h3>
                  <span>{essay.title.en}</span>
                </h3>

                {essay.director && (
                  <p class="essay-director">
                    <span aria-hidden="true">🎬 </span>
                    <span>{essay.director}</span>
                    {essay.year && <span class="essay-year">({essay.year})</span>}
                  </p>
                )}

                {essay.genres.length > 0 && (
                  <div class="essay-genres">
                    {essay.genres.map(g => (
                      <button class="genre-tag" type="button" data-genre={g}>{g}</button>
                    ))}
                  </div>
                )}

                <p class="essay-excerpt">{essay.excerpt.en}</p>

                <div class="essay-action">
                  <a href={essay.href} class="essay-link">
                    Read full →
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div id="noResults" class="no-results hidden">
        <p>No essays match your search criteria.</p>
      </div>

      <!-- Pagination Controls -->
      <nav class="pagination" id="paginationControls" aria-label="Pagination">
        <button id="prevPageBtn" class="page-nav-btn" type="button" disabled>
          ← Previous
        </button>
        <div id="pageNumbers" class="page-numbers"></div>
        <button id="nextPageBtn" class="page-nav-btn" type="button" disabled>
          Next →
        </button>
      </nav>
    </div>
  </section>
</Layout>

<script>
  const FUSE_CDN = 'https://cdn.jsdelivr.net/npm/fuse.js@7/dist/fuse.min.js';

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const genreSelect = document.getElementById('genreSelect') as HTMLSelectElement | null;
    const directorSelect = document.getElementById('directorSelect') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('resetFiltersBtn');
    const alphabetBar = document.getElementById('alphabetBar');
    const alphaButtons = alphabetBar?.querySelectorAll('.alpha-btn') || [];
    const essayCards = Array.from(document.querySelectorAll('.essay-card')) as HTMLElement[];
    const genreTags = Array.from(document.querySelectorAll('.genre-tag')) as HTMLButtonElement[];
    const resultsCount = document.getElementById('resultsCount');
    const noResults = document.getElementById('noResults');
    const paginationControls = document.getElementById('paginationControls');
    const prevPageBtn = document.getElementById('prevPageBtn') as HTMLButtonElement | null;
    const nextPageBtn = document.getElementById('nextPageBtn') as HTMLButtonElement | null;
    const pageNumbers = document.getElementById('pageNumbers');
    const searchLoading = document.getElementById('searchLoading');

    const ITEMS_PER_PAGE = 16;
    let currentPage = 1;
    let selectedLetter = '';
    let matchingCards: HTMLElement[] = [];

    type FuseInstance = any;
    let fuse: FuseInstance | null = null;
    let fuseLoading = false;
    let fuseReady = false;
    let fullTextSlugs: Set<string> | null = null;

    function setLoadingIndicator(visible: boolean) {
      if (!searchLoading) return;
      searchLoading.hidden = !visible;
    }

    async function loadFuse() {
      if (fuseReady || fuseLoading) return;
      fuseLoading = true;
      setLoadingIndicator(true);

      try {
        if (!(window as any).Fuse) {
          await new Promise<void>((resolve, reject) => {
            const script = document.createElement('script');
            script.src = FUSE_CDN;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('Fuse.js load failed'));
            document.head.appendChild(script);
          });
        }

        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        fuse = new (window as any).Fuse(data, {
          keys: [
            { name: 'title_en',  weight: 0.30 },
            { name: 'director',  weight: 0.20 },
            { name: 'genres',    weight: 0.20 },
            { name: 'body_en',   weight: 0.30 },
          ],
          threshold: 0.35,
          minMatchCharLength: 3,
          includeScore: true,
          ignoreLocation: true,
        });

        fuseReady = true;
      } catch (err) {
        console.warn('[Search] Failed to load full-text index:', err);
        fuseReady = false;
      } finally {
        fuseLoading = false;
        setLoadingIndicator(false);
        filterEssays();
      }
    }

    function runFullTextSearch(query: string): Set<string> | null {
      if (!fuseReady || !fuse || query.length < 3) return null;
      const results = fuse.search(query);
      return new Set(results.map((r: any) => r.item.slug as string));
    }

    let lastRenderedTotalPages = -1;

    function renderPagination(totalPages: number) {
      if (!pageNumbers || !paginationControls) return;

      if (totalPages <= 1) {
        paginationControls.style.display = 'none';
        lastRenderedTotalPages = totalPages;
        return;
      }

      paginationControls.style.display = 'flex';

      if (totalPages !== lastRenderedTotalPages) {
        pageNumbers.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.className = 'page-num-btn';
          btn.textContent = i.toString();
          btn.type = 'button';
          btn.dataset.page = String(i);
          btn.addEventListener('click', () => {
            currentPage = i;
            updateGridDisplay();
            scrollToGridTop();
            syncUrl();
          });
          pageNumbers.appendChild(btn);
        }
        lastRenderedTotalPages = totalPages;
      }

      pageNumbers.querySelectorAll<HTMLButtonElement>('.page-num-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.page === String(currentPage));
      });

      if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
      if (nextPageBtn) nextPageBtn.disabled = currentPage === totalPages;
    }

    function scrollToGridTop() {
      document.querySelector('.archive-controls')
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function updateGridDisplay() {
      const totalMatching = matchingCards.length;
      const totalPages = Math.ceil(totalMatching / ITEMS_PER_PAGE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      essayCards.forEach(card => card.classList.add('hidden'));

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const pageCards = matchingCards.slice(startIndex, startIndex + ITEMS_PER_PAGE);
      pageCards.forEach(card => card.classList.remove('hidden'));

      if (resultsCount) {
        if (totalMatching === 0) {
          resultsCount.textContent = '0 essays found';
        } else {
          const source = fuseReady ? ' (full-text)' : '';
          resultsCount.textContent = `Showing ${pageCards.length} of ${totalMatching} essays${source} (Page ${currentPage} of ${totalPages})`;
        }
      }

      if (noResults) {
        noResults.classList.toggle('hidden', totalMatching > 0);
      }

      renderPagination(totalPages);
    }

    function filterEssays() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedDirector = (directorSelect?.value || '').toLowerCase().trim();
      const selectedGenre = (genreSelect?.value || '').toLowerCase().trim();

      fullTextSlugs = runFullTextSearch(query);

      matchingCards = essayCards.filter(card => {
        const searchable = card.dataset.searchable || '';
        const director   = card.dataset.director   || '';
        const cardGenres = (card.dataset.genres    || '').split(',');
        const slug       = card.dataset.slug        || '';
        const firstLetter = card.dataset.firstLetter || '';

        let matchesQuery = true;
        if (query) {
          if (fullTextSlugs !== null) {
            matchesQuery = searchable.includes(query) || fullTextSlugs.has(slug);
          } else {
            matchesQuery = searchable.includes(query);
          }
        }

        const matchesDirector = !selectedDirector || director === selectedDirector;
        const matchesGenre = !selectedGenre || cardGenres.includes(selectedGenre);

        let matchesLetter = true;
        if (selectedLetter) {
          matchesLetter = selectedLetter === 'NUM'
            ? /^[0-9]/.test(firstLetter)
            : firstLetter === selectedLetter;
        }

        return matchesQuery && matchesDirector && matchesGenre && matchesLetter;
      });

      currentPage = 1;
      updateGridDisplay();
    }

    function syncUrl() {
      const params = new URLSearchParams();
      const q   = searchInput?.value.trim() || '';
      const dir = directorSelect?.value || '';
      const gen = genreSelect?.value || '';
      if (q)              params.set('q', q);
      if (dir)            params.set('director', dir);
      if (gen)            params.set('genre', gen);
      if (selectedLetter) params.set('letter', selectedLetter);
      if (currentPage > 1) params.set('page', String(currentPage));
      const newUrl = params.toString()
        ? `${location.pathname}?${params}`
        : location.pathname;
      history.replaceState(null, '', newUrl);
    }

    function restoreFromUrl() {
      const params = new URLSearchParams(location.search);
      const q      = params.get('q')        || '';
      const dir    = params.get('director') || '';
      const gen    = params.get('genre')    || '';
      const letter = params.get('letter')   || '';
      const page   = parseInt(params.get('page') || '1', 10);

      if (searchInput && q)      searchInput.value    = q;
      if (directorSelect && dir) directorSelect.value = dir;
      if (genreSelect && gen)    genreSelect.value    = gen;
      if (letter) {
        selectedLetter = letter;
        alphaButtons.forEach(b => {
          const isActive = (b as HTMLElement).dataset.letter === letter;
          b.classList.toggle('active', isActive);
          (b as HTMLElement).setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }
      currentPage = isNaN(page) || page < 1 ? 1 : page;
    }

    searchInput?.addEventListener('focus', loadFuse, { once: true });

    let searchTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimer);
      if (!fuseReady && !fuseLoading && (searchInput?.value.trim().length ?? 0) >= 3) {
        loadFuse();
      }
      searchTimer = setTimeout(() => {
        filterEssays();
        syncUrl();
      }, 200);
    });

    directorSelect?.addEventListener('change', () => {
      filterEssays();
      syncUrl();
    });

    genreSelect?.addEventListener('change', () => {
      filterEssays();
      syncUrl();
    });

    genreTags.forEach(tag => {
      tag.addEventListener('click', (e) => {
        e.preventDefault();
        const targetGenre = tag.dataset.genre || '';
        if (genreSelect) {
          genreSelect.value = targetGenre;
          filterEssays();
          syncUrl();
          scrollToGridTop();
        }
      });
    });

    alphaButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        alphaButtons.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        (btn as HTMLElement).setAttribute('aria-pressed', 'true');
        selectedLetter = (btn as HTMLElement).dataset.letter || '';
        filterEssays();
        syncUrl();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput)    searchInput.value    = '';
      if (directorSelect) directorSelect.value = '';
      if (genreSelect)    genreSelect.value    = '';
      selectedLetter = '';
      alphaButtons.forEach(b => {
        b.classList.remove('active');
        (b as HTMLElement).setAttribute('aria-pressed', 'false');
      });
      const allBtn = alphabetBar?.querySelector('[data-letter=""]');
      allBtn?.classList.add('active');
      (allBtn as HTMLElement | null)?.setAttribute('aria-pressed', 'true');
      filterEssays();
      syncUrl();
    });

    prevPageBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updateGridDisplay();
        scrollToGridTop();
        syncUrl();
      }
    });

    nextPageBtn?.addEventListener('click', () => {
      const totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE);
      if (currentPage < totalPages) {
        currentPage++;
        updateGridDisplay();
        scrollToGridTop();
        syncUrl();
      }
    });

    restoreFromUrl();
    filterEssays();
  });
</script>

<style>
  .archive-header { padding: 4rem 0 2rem; border-bottom: 1px solid var(--border); }
  .back-link { display: inline-block; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; margin-bottom: 1.5rem; transition: color 0.15s ease; }
  .back-link:hover { color: var(--accent); }
  .archive-header h1 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 1rem; }
  .lead { color: var(--text-muted); font-size: 1.05rem; margin: 0; }

  .archive-controls { margin-top: 2.5rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .search-bar-row { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .search-input-group { position: relative; flex: 1 1 260px; }
  .search-input-group input { width: 100%; padding: 0.75rem 2.5rem 0.75rem 1rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; color: var(--text); font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s ease; }
  .search-input-group input:focus { outline: none; border-color: var(--accent); }
  .search-icon { position: absolute; right: 0.8rem; top: 50%; transform: translateY(-50%); opacity: 0.5; pointer-events: none; }

  .filter-select-group select { padding: 0.75rem 1rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 4px; color: var(--text); font-size: 0.95rem; font-family: inherit; cursor: pointer; transition: border-color 0.2s ease; }
  .filter-select-group select:focus { outline: none; border-color: var(--accent); }

  .reset-btn { padding: 0.75rem 1.2rem; background: transparent; border: 1px solid var(--border); color: var(--text-muted); border-radius: 4px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s ease; font-family: inherit; }
  .reset-btn:hover { border-color: var(--accent); color: var(--accent); }

  .alphabet-bar { display: flex; flex-wrap: wrap; gap: 0.35rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }
